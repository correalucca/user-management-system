# Copie para .env e ajuste (o arquivo .env não deve ir para o repositório).

# Porta HTTP do Express
PORT=3000

# Caminho do JSON de usuários: relativo à pasta do projeto ou absoluto.
# Padrão: data/usuarios.json
# DATA_FILE=data/usuarios.json

# Limite do body JSON (ex.: 100kb, 1mb)
# JSON_BODY_LIMIT=100kb
